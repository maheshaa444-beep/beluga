# Tile source: hosted Protomaps key (now) or self-hosted PMTiles (later).
# At least one of these should be set for a live basemap.

# Hosted API: https://protomaps.com/api
NEXT_PUBLIC_PROTOMAPS_API_KEY=

# Alternate source URL. Accepts:
# - TileJSON: https://api.protomaps.com/tiles/v4.json?key=YOUR_KEY
# - ZXY template: https://api.protomaps.com/tiles/v4/{z}/{x}/{y}.mvt?key=YOUR_KEY
# - PMTiles: pmtiles://https://example.com/planet.pmtiles
NEXT_PUBLIC_MAP_TILES_URL=
